set nocompatible
set noswapfile

filetype plugin indent on
syntax on
packadd! matchit

colorscheme plain256
highlight CursorLine cterm=bold ctermbg=Black

if &diff
  set diffopt+=iwhite
endif

if &bin
  au BufReadPost * %!xxd
  au BufWritePre * %!xxd -r
endif

" GDB integration
" packadd termdebug
let g:termdebug_wide = 80

" netrw file browser tree list and no banner
let g:netrw_banner = 0
let g:netrw_liststyle = 3

set showmode
set wildmenu
set number
set list
set listchars=tab:↹∘,trail:∙
set matchpairs+=<:>
set cursorline
set colorcolumn=79
set laststatus=2

set hlsearch
set incsearch

set mouse=a

set virtualedit=all

set autoindent
set expandtab
set tabstop=4
set softtabstop=4
set shiftwidth=4

set scrolloff=9


" Ctrl+arrow moves between splits; at the edge it hands over to tmux panes
function! s:Navigate(dir)
  let l:nr = winnr()
  execute 'wincmd ' . a:dir
  if winnr() == l:nr && !empty($TMUX)
    call system('tmux select-pane -' . tr(a:dir, 'hjkl', 'LDUR'))
  endif
endfunction

for [s:key, s:dir] in [['Left', 'h'], ['Down', 'j'], ['Up', 'k'], ['Right', 'l']]
  execute 'nnoremap <silent> <C-' . s:key . '> :call <SID>Navigate("' . s:dir . '")<CR>'
  execute 'tnoremap <silent> <C-' . s:key . '> <C-w>:call <SID>Navigate("' . s:dir . '")<CR>'
endfor
